{
  "name": "availability-scheduler",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write src server shared tests scripts playwright.config.ts",
    "format:check": "prettier --check src server shared tests scripts playwright.config.ts",
    "verify": "npm run format:check && npm test && npm run build",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:report": "playwright show-report",
    "provision:account": "tsx scripts/provision-account.ts",
    "reports:retry": "tsx scripts/retry-reports.ts",
    "reports:demo": "tsx scripts/demo-reports.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "fontkit": "^2.0.4",
    "luxon": "^3.7.2",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.20.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.3",
    "@types/fontkit": "^2.0.9",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.3.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.9",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
