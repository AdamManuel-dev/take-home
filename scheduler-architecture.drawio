<?xml version="1.0" encoding="UTF-8"?><mxfile host="Electron" type="device"><diagram id="page-1" name="Architecture"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1240" pageHeight="1180" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Open Hours | Application architecture&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1160" height="45" as="geometry"/></mxCell><mxCell id="subtitle" value="React + TypeScript / Express + Node.js / local JSON persistence. Current implementation, including booking." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1160" height="40" as="geometry"/></mxCell><mxCell id="ui" value="&lt;b&gt;React interface&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;src/app.tsx&lt;/b&gt;&lt;br&gt;Staff creation and selection&lt;br&gt;&lt;br&gt;&lt;b&gt;StaffWorkspace&lt;/b&gt;&lt;br&gt;WeeklyDay + WindowInputs&lt;br&gt;OverrideEditor&lt;br&gt;AvailabilityPanel + booking form&lt;br&gt;AppointmentAgenda&lt;br&gt;&lt;br&gt;Unsaved drafts stay separate from saved state." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=16;fillColor=#EAF3EF;strokeColor=#A4B9AD;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="300" height="300" as="geometry"/></mxCell><mxCell id="client" value="&lt;b&gt;Client request state&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;src/lib/api.ts&lt;/b&gt; — JSON transport&lt;br&gt;&lt;b&gt;use-availability.ts&lt;/b&gt; — request versions&lt;br&gt;&lt;br&gt;Ignore stale search responses.&lt;br&gt;Invalidate results after mutations.&lt;br&gt;Guard pending saves and surface errors." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=16;fillColor=#EDF2FA;strokeColor=#A4B9AD;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="300" height="190" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;Express HTTP adapter&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;server/app.ts&lt;/b&gt;&lt;br&gt;Staff, hours, overrides, slots, bookings&lt;br&gt;Validate input; coordinate operations&lt;br&gt;Return JSON errors and status codes&lt;br&gt;Serve dist/ in production" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=16;fillColor=#EDF2FA;strokeColor=#A4B9AD;" vertex="1" parent="1"><mxGeometry x="440" y="160" width="320" height="200" as="geometry"/></mxCell><mxCell id="domain" value="&lt;b&gt;Pure scheduling + booking rules&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;server/scheduling.ts&lt;/b&gt;&lt;br&gt;Validate dates / windows / durations&lt;br&gt;Resolve overrides, merge continuous hours&lt;br&gt;Generate slots, exclude booked overlaps&lt;br&gt;&lt;br&gt;&lt;b&gt;server/appointments.ts&lt;/b&gt;&lt;br&gt;Verify the requested slot is still offered&lt;br&gt;No HTTP, React, or filesystem imports" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=16;fillColor=#FDF3DC;strokeColor=#A4B9AD;" vertex="1" parent="1"><mxGeometry x="860" y="160" width="340" height="250" as="geometry"/></mxCell><mxCell id="port" value="&lt;b&gt;StaffRepository contract&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;server/repository.ts&lt;/b&gt;&lt;br&gt;list() → Staff[]&lt;br&gt;get(id) → StaffRecord | undefined&lt;br&gt;create(name) → Staff&lt;br&gt;update(id, change) → Schedule" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=16;fillColor=#EAF3EF;strokeColor=#A4B9AD;" vertex="1" parent="1"><mxGeometry x="440" y="430" width="320" height="150" as="geometry"/></mxCell><mxCell id="store" value="&lt;b&gt;JSON store adapter&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;server/store.ts&lt;/b&gt;&lt;br&gt;Clone → change → write temp → rename&lt;br&gt;Publish memory only after successful write&lt;br&gt;Detached reads and update results&lt;br&gt;Best-effort cleanup after write failure" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=16;fillColor=#EAF3EF;strokeColor=#A4B9AD;" vertex="1" parent="1"><mxGeometry x="440" y="650" width="320" height="160" as="geometry"/></mxCell><mxCell id="parser" value="&lt;b&gt;Persistence boundary validation&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;server/stored-data.ts&lt;/b&gt;&lt;br&gt;Check version + nested records at startup&lt;br&gt;Unique IDs / dates, valid windows&lt;br&gt;Valid durations; no overlapping bookings&lt;br&gt;Accept legacy omitted appointments" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=16;fillColor=#FDF3DC;strokeColor=#A4B9AD;" vertex="1" parent="1"><mxGeometry x="860" y="650" width="340" height="160" as="geometry"/></mxCell><mxCell id="file" value="&lt;b&gt;data/schedules.json&lt;/b&gt;&lt;br&gt;&lt;br&gt;{ version: 1, staff: StaffRecord[] }&lt;br&gt;&lt;br&gt;DATA_FILE can override the path.&lt;br&gt;Existing records survive app restarts." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=16;fillColor=#F3EEE6;strokeColor=#A4B9AD;shape=mxgraph.flowchart.document;" vertex="1" parent="1"><mxGeometry x="440" y="900" width="320" height="150" as="geometry"/></mxCell><mxCell id="wiring" value="&lt;b&gt;Composition + runtime&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;server/index.ts&lt;/b&gt;&lt;br&gt;createApp(new Store()).listen(...)&lt;br&gt;&lt;br&gt;Development: Vite :5173 proxies /api&lt;br&gt;to Express at 127.0.0.1:3001.&lt;br&gt;Production: Express serves UI + API." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=16;fillColor=#F4F5F6;strokeColor=#A4B9AD;" vertex="1" parent="1"><mxGeometry x="860" y="900" width="340" height="180" as="geometry"/></mxCell><mxCell id="rules" value="&lt;b&gt;Atomic booking boundary&lt;/b&gt;&lt;br&gt;&lt;br&gt;POST appointment runs validation inside&lt;br&gt;the synchronous repository update.&lt;br&gt;&lt;br&gt;Conflicting concurrent requests cannot&lt;br&gt;both commit within one Node process.&lt;br&gt;Multi-process coordination is out of scope." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=16;fillColor=#FDF3DC;strokeColor=#A4B9AD;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="300" height="180" as="geometry"/></mxCell><mxCell id="edge-1" value="uses" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;endFill=1;dashed=0;strokeColor=#58756A;labelBackgroundColor=#FFFFFF;fontSize=12;" edge="1" parent="1" source="ui" target="client"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="JSON /api" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.2;entryX=0;entryY=0.7;rounded=1;endArrow=classic;endFill=1;dashed=0;strokeColor=#58756A;labelBackgroundColor=#FFFFFF;fontSize=12;" edge="1" parent="1" source="client" target="api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-3" value="validates / calculates" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;endFill=1;dashed=0;strokeColor=#58756A;labelBackgroundColor=#FFFFFF;fontSize=12;" edge="1" parent="1" source="api" target="domain"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-4" value="depends on" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;endFill=1;dashed=0;strokeColor=#58756A;labelBackgroundColor=#FFFFFF;fontSize=12;" edge="1" parent="1" source="api" target="port"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-5" value="implements" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=0;dashed=1;strokeColor=#58756A;labelBackgroundColor=#FFFFFF;fontSize=12;" edge="1" parent="1" source="store" target="port"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-6" value="atomic replacement" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;endFill=1;dashed=0;strokeColor=#58756A;labelBackgroundColor=#FFFFFF;fontSize=12;" edge="1" parent="1" source="store" target="file"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-7" value="startup validation" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;endFill=1;dashed=0;strokeColor=#58756A;labelBackgroundColor=#FFFFFF;fontSize=12;" edge="1" parent="1" source="store" target="parser"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-8" value="reuses validators" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;endFill=1;dashed=0;strokeColor=#58756A;labelBackgroundColor=#FFFFFF;fontSize=12;" edge="1" parent="1" source="parser" target="domain"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Shared types:&lt;/b&gt; shared/types.ts links frontend and backend contracts. Solid arrows = calls / data access; dashed = implements." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1100" width="1160" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>