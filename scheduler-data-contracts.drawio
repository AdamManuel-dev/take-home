<?xml version="1.0" encoding="UTF-8"?><mxfile host="Electron" type="device"><diagram id="page-1" name="Stored model"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1180" pageHeight="1160" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Open Hours | Stored data and shared contracts&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1100" height="45" as="geometry"/></mxCell><mxCell id="subtitle" value="Actual TypeScript and JSON shapes. Relationships show embedded fields, not database tables or foreign keys." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1100" height="40" as="geometry"/></mxCell><mxCell id="data" value="&lt;b&gt;Stored document&lt;/b&gt;&lt;br&gt;&lt;br&gt;version: 1&lt;br&gt;staff: StaffRecord[]&lt;br&gt;&lt;br&gt;File: data/schedules.json" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=16;fillColor=#EAF3EF;strokeColor=#A4B9AD;" vertex="1" parent="1"><mxGeometry x="410" y="160" width="300" height="145" as="geometry"/></mxCell><mxCell id="record" value="&lt;b&gt;StaffRecord = Staff &amp;amp; Schedule&lt;/b&gt;&lt;br&gt;&lt;br&gt;id: string (generated UUID)&lt;br&gt;name: string (trimmed, 1–100 chars)&lt;br&gt;weekly: Window[][]&lt;br&gt;overrides: Override[]&lt;br&gt;appointments?: Appointment[]" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=16;fillColor=#EAF3EF;strokeColor=#A4B9AD;" vertex="1" parent="1"><mxGeometry x="410" y="380" width="300" height="190" as="geometry"/></mxCell><mxCell id="staff" value="&lt;b&gt;Staff identity response&lt;/b&gt;&lt;br&gt;&lt;br&gt;id: string&lt;br&gt;name: string&lt;br&gt;&lt;br&gt;Names may repeat.&lt;br&gt;Identity always uses the stable ID." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=16;fillColor=#EDF2FA;strokeColor=#A4B9AD;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="280" height="170" as="geometry"/></mxCell><mxCell id="schedule" value="&lt;b&gt;Schedule response&lt;/b&gt;&lt;br&gt;&lt;br&gt;weekly: Window[][]&lt;br&gt;overrides: Override[]&lt;br&gt;appointments: Appointment[]&lt;br&gt;&lt;br&gt;API returns [] for legacy missing bookings." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=16;fillColor=#EDF2FA;strokeColor=#A4B9AD;" vertex="1" parent="1"><mxGeometry x="800" y="380" width="330" height="190" as="geometry"/></mxCell><mxCell id="window" value="&lt;b&gt;Window / recurring hours&lt;/b&gt;&lt;br&gt;&lt;br&gt;start: integer minute&lt;br&gt;end: integer minute&lt;br&gt;&lt;br&gt;0 ≤ start &amp;lt; end ≤ 1440&lt;br&gt;weekly has exactly 7 day arrays.&lt;br&gt;Sunday = 0 … Saturday = 6.&lt;br&gt;Each day contains 0..96 windows.&lt;br&gt;Reject overlaps; allow touching hours." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=16;fillColor=#EAF3EF;strokeColor=#A4B9AD;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="300" height="245" as="geometry"/></mxCell><mxCell id="override" value="&lt;b&gt;Override&lt;/b&gt;&lt;br&gt;&lt;br&gt;date: YYYY-MM-DD&lt;br&gt;mode: unavailable | replace | add&lt;br&gt;windows: Window[]&lt;br&gt;&lt;br&gt;Unique date per staff.&lt;br&gt;Unavailable: no windows.&lt;br&gt;Replace/add: at least one window.&lt;br&gt;At most 96 submitted windows." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=16;fillColor=#FDF3DC;strokeColor=#A4B9AD;" vertex="1" parent="1"><mxGeometry x="410" y="700" width="300" height="245" as="geometry"/></mxCell><mxCell id="appointment" value="&lt;b&gt;Appointment extends Window&lt;/b&gt;&lt;br&gt;&lt;br&gt;id: string (generated UUID)&lt;br&gt;date: YYYY-MM-DD&lt;br&gt;title: string (trimmed, 1–100 chars)&lt;br&gt;start: integer minute&lt;br&gt;end: integer minute&lt;br&gt;&lt;br&gt;end − start ∈ {15, 30, 45, 60}&lt;br&gt;No overlapping bookings per staff/date." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=16;fillColor=#F3EEE6;strokeColor=#A4B9AD;" vertex="1" parent="1"><mxGeometry x="800" y="700" width="330" height="245" as="geometry"/></mxCell><mxCell id="edge-1" value="0..* records" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;endFill=1;dashed=0;strokeColor=#58756A;labelBackgroundColor=#FFFFFF;fontSize=12;" edge="1" parent="1" source="data" target="record"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="identity projection" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;endFill=1;dashed=0;strokeColor=#58756A;labelBackgroundColor=#FFFFFF;fontSize=12;" edge="1" parent="1" source="record" target="staff"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-3" value="schedule projection" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;endFill=1;dashed=0;strokeColor=#58756A;labelBackgroundColor=#FFFFFF;fontSize=12;" edge="1" parent="1" source="record" target="schedule"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-4" value="weekly: 7 arrays" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;exitX=0.2;exitY=1;entryX=0.5;entryY=0;rounded=1;endArrow=classic;endFill=1;dashed=0;strokeColor=#58756A;labelBackgroundColor=#FFFFFF;fontSize=12;" edge="1" parent="1" source="record" target="window"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-5" value="0..* overrides" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;endFill=1;dashed=0;strokeColor=#58756A;labelBackgroundColor=#FFFFFF;fontSize=12;" edge="1" parent="1" source="record" target="override"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-6" value="0..* bookings" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;exitX=0.8;exitY=1;entryX=0.5;entryY=0;rounded=1;endArrow=classic;endFill=1;dashed=0;strokeColor=#58756A;labelBackgroundColor=#FFFFFF;fontSize=12;" edge="1" parent="1" source="record" target="appointment"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="model-note" value="&lt;b&gt;Value reuse:&lt;/b&gt; Override.windows, DayResult.windows, and DayResult.slots all use Window.&lt;br&gt;&lt;b&gt;Legacy compatibility:&lt;/b&gt; appointments may be omitted in stored version-1 records; reads expose an empty array.&lt;br&gt;&lt;b&gt;Time semantics:&lt;/b&gt; America/Chicago wall-clock dates and minutes; no UTC appointment timestamps. Intervals are [start, end).&lt;br&gt;&lt;b&gt;Preservation:&lt;/b&gt; changing availability does not cancel existing appointments." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="1090" height="105" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-2" name="API contracts"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1500" pageHeight="1290" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Open Hours | API request and response contracts&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1420" height="45" as="geometry"/></mxCell><mxCell id="subtitle" value="JSON over /api. Staff-scoped base path: /api/staff/:id. Successful mutations return authoritative saved data." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1420" height="40" as="geometry"/></mxCell><mxCell id="readreq" value="&lt;b&gt;Read requests&lt;/b&gt;&lt;br&gt;&lt;br&gt;GET /api/staff&lt;br&gt;&lt;br&gt;GET /api/staff/:id/schedule" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=16;fillColor=#EDF2FA;strokeColor=#A4B9AD;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="370" height="135" as="geometry"/></mxCell><mxCell id="readres" value="&lt;b&gt;Read responses&lt;/b&gt;&lt;br&gt;&lt;br&gt;200 → Staff[]&lt;br&gt;&lt;br&gt;200 → Schedule&lt;br&gt;(appointments always present as an array)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=16;fillColor=#EAF3EF;strokeColor=#A4B9AD;" vertex="1" parent="1"><mxGeometry x="550" y="160" width="370" height="135" as="geometry"/></mxCell><mxCell id="readnotes" value="&lt;b&gt;Identity rules&lt;/b&gt;&lt;br&gt;&lt;br&gt;Unknown staff → 404&lt;br&gt;Duplicate names are allowed.&lt;br&gt;Agenda filters saved appointments in React." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=16;fillColor=#F4F5F6;strokeColor=#A4B9AD;" vertex="1" parent="1"><mxGeometry x="1060" y="160" width="390" height="135" as="geometry"/></mxCell><mxCell id="edge-1" value="200" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;endFill=1;dashed=0;strokeColor=#58756A;labelBackgroundColor=#FFFFFF;fontSize=12;" edge="1" parent="1" source="readreq" target="readres"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="mutreq" value="&lt;b&gt;Staff and availability writes&lt;/b&gt;&lt;br&gt;&lt;br&gt;POST /api/staff&lt;br&gt;{ name: string }&lt;br&gt;&lt;br&gt;PUT :base/weekly/:day&lt;br&gt;{ windows: Window[] }&lt;br&gt;&lt;br&gt;PUT :base/overrides/:date&lt;br&gt;{ mode: OverrideMode, windows: Window[] }&lt;br&gt;&lt;br&gt;DELETE :base/overrides/:date&lt;br&gt;No request body" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=16;fillColor=#EDF2FA;strokeColor=#A4B9AD;" vertex="1" parent="1"><mxGeometry x="40" y="365" width="370" height="300" as="geometry"/></mxCell><mxCell id="mutres" value="&lt;b&gt;Write responses&lt;/b&gt;&lt;br&gt;&lt;br&gt;Create staff: 201 → Staff&lt;br&gt;&lt;br&gt;Save weekday: 200 → Schedule&lt;br&gt;Save override: 200 → Schedule&lt;br&gt;Delete override: 200 → Schedule&lt;br&gt;&lt;br&gt;One weekday or one date replaced atomically.&lt;br&gt;Deleting an override restores weekly rules." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=16;fillColor=#EAF3EF;strokeColor=#A4B9AD;" vertex="1" parent="1"><mxGeometry x="550" y="365" width="370" height="260" as="geometry"/></mxCell><mxCell id="constraints" value="&lt;b&gt;Request validation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Weekday is 0..6.&lt;br&gt;Times are numbers, not HH:MM strings.&lt;br&gt;Replace/add require nonempty windows.&lt;br&gt;Unavailable requires empty windows.&lt;br&gt;Real YYYY-MM-DD calendar dates.&lt;br&gt;&lt;br&gt;Client converts HH:MM to minutes." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=16;fillColor=#FDF3DC;strokeColor=#A4B9AD;" vertex="1" parent="1"><mxGeometry x="1060" y="365" width="390" height="260" as="geometry"/></mxCell><mxCell id="edge-2" value="201 / 200" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;endFill=1;dashed=0;strokeColor=#58756A;labelBackgroundColor=#FFFFFF;fontSize=12;" edge="1" parent="1" source="mutreq" target="mutres"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="query" value="&lt;b&gt;Availability query&lt;/b&gt;&lt;br&gt;&lt;br&gt;POST :base/availability&lt;br&gt;{ start: string, end: string,&lt;br&gt;  duration: 15 | 30 | 45 | 60 }&lt;br&gt;&lt;br&gt;Dates inclusive; start ≤ end.&lt;br&gt;Maximum 90 calendar dates.&lt;br&gt;Past dates allowed." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=16;fillColor=#EDF2FA;strokeColor=#A4B9AD;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="370" height="200" as="geometry"/></mxCell><mxCell id="result" value="&lt;b&gt;200 → DayResult[]&lt;/b&gt;&lt;br&gt;&lt;br&gt;date: YYYY-MM-DD&lt;br&gt;source: weekly | override | combined | none&lt;br&gt;mode?: unavailable | replace | add&lt;br&gt;windows: Window[] (effective working hours)&lt;br&gt;slots: Window[] (fitting unbooked intervals)&lt;br&gt;reason?: string (when no slots)&lt;br&gt;&lt;br&gt;One result per date, chronologically ordered." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=16;fillColor=#EAF3EF;strokeColor=#A4B9AD;" vertex="1" parent="1"><mxGeometry x="550" y="740" width="370" height="245" as="geometry"/></mxCell><mxCell id="errors" value="&lt;b&gt;Shared error envelope&lt;/b&gt;&lt;br&gt;&lt;br&gt;{ error: string }&lt;br&gt;&lt;br&gt;400 — invalid fields / scheduling input&lt;br&gt;404 — unknown staff / booking / API route&lt;br&gt;409 — booking slot no longer available&lt;br&gt;413 — JSON payload too large&lt;br&gt;500 — internal or persistence failure&lt;br&gt;&lt;br&gt;Errors do not report successful saves." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=16;fillColor=#FBEDEC;strokeColor=#A4B9AD;" vertex="1" parent="1"><mxGeometry x="1060" y="740" width="390" height="245" as="geometry"/></mxCell><mxCell id="edge-3" value="200" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;endFill=1;dashed=0;strokeColor=#58756A;labelBackgroundColor=#FFFFFF;fontSize=12;" edge="1" parent="1" source="query" target="result"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="bookreq" value="&lt;b&gt;Booking mutations&lt;/b&gt;&lt;br&gt;&lt;br&gt;POST :base/appointments&lt;br&gt;{ date: string, title: string,&lt;br&gt;  start: number, duration: 15 | 30 | 45 | 60 }&lt;br&gt;&lt;br&gt;DELETE :base/appointments/:appointmentId&lt;br&gt;No request body" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=16;fillColor=#EDF2FA;strokeColor=#A4B9AD;" vertex="1" parent="1"><mxGeometry x="40" y="1050" width="370" height="190" as="geometry"/></mxCell><mxCell id="bookres" value="&lt;b&gt;Booking responses&lt;/b&gt;&lt;br&gt;&lt;br&gt;Book: 201 → Schedule&lt;br&gt;Cancel: 200 → Schedule&lt;br&gt;&lt;br&gt;Server creates ID and computes end.&lt;br&gt;Require an exact currently offered slot.&lt;br&gt;Conflicts checked inside the update." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=16;fillColor=#EAF3EF;strokeColor=#A4B9AD;" vertex="1" parent="1"><mxGeometry x="550" y="1050" width="370" height="190" as="geometry"/></mxCell><mxCell id="booknotes" value="&lt;b&gt;Availability after booking&lt;/b&gt;&lt;br&gt;&lt;br&gt;Exclude each candidate slot overlapping a&lt;br&gt;saved appointment; keep original slot grid.&lt;br&gt;Adjacent bookings are allowed.&lt;br&gt;Cancellation restores eligible slots.&lt;br&gt;&lt;br&gt;UI invalidates results after mutations." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;rounded=1;arcSize=8;align=left;verticalAlign=top;spacing=16;fillColor=#FDF3DC;strokeColor=#A4B9AD;" vertex="1" parent="1"><mxGeometry x="1060" y="1050" width="390" height="190" as="geometry"/></mxCell><mxCell id="edge-4" value="201 / 200" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#243B35;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;endFill=1;dashed=0;strokeColor=#58756A;labelBackgroundColor=#FFFFFF;fontSize=12;" edge="1" parent="1" source="bookreq" target="bookres"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>